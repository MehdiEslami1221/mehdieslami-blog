{
  "name": "mehdieslami-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "web",
    "studio"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/fetch-content.mjs && npm run build -w web && node scripts/finish-export.mjs",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w studio",
    "test": "node --test tests/*.test.mjs",
    "studio:dev": "npm run dev -w studio",
    "studio:build": "npm run build -w studio",
    "studio:deploy": "npm run deploy -w studio",
    "sync": "node scripts/fetch-content.mjs"
  },
  "devDependencies": {
    "jsdom": "29.1.1"
  }
}
